__pycache__/
*.pyc
# Downloaded by tools/fetch_faith.py (public domain, ~32 MB) — fetched at setup, not stored in git
faith/*.tsv
faith/catalog.json
# Official documents the operator adds
library/*
!library/README.md
# Build output
dist/
*.zip
site/dist/
site/.wrangler/
# Offline voice model (tools/install_voice.py)
voice-model/
site/.stage/
site/.cache/
books/*
!books/README.md
# Installers handed out by a demo box / USB drive (tools/make_usb.py)
downloads/
# Official DVIDS videos saved by tools/fetch_videos.py (large; copied to a USB drive by make_usb.py)
videos/

# Never commit keys, certificates or local secrets (security review 2026-10). The release key lives in ~/.vanguard-release.
*.pem
*.key
*.pfx
*.p12
.env
.env.*
.dev.vars
node_modules/
